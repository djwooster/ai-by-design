# Copy to .env.local for development; set the same names in Vercel for production.
# Every integration is optional: with its keys missing, that feature says so and the site still runs.

# The site's public URL, for Stripe redirects and links in emails.
NEXT_PUBLIC_SITE_URL=http://localhost:3003

# Stripe. Use a restricted key (rk_…) with write access to Checkout Sessions only,
# from a sandbox while developing. The webhook secret comes from `stripe listen`
# locally, or from the endpoint you add in the Dashboard (/api/stripe/webhook).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Resend: delivery emails and the list.
RESEND_API_KEY=
EMAIL_FROM="DJ Wooster <dj@ai-bydesign.dev>"
EMAIL_REPLY_TO=
# Segment IDs from Resend, one per sign-up tag. Build the sequence as a Resend automation on each segment.
RESEND_SEGMENT_CHECKLIST=
RESEND_SEGMENT_SOURCEIQ=
# The checklist PDF the first email links to.
CHECKLIST_URL=

# Vercel Blob: product files live in a private store. Created automatically when you connect a store in Vercel.
BLOB_READ_WRITE_TOKEN=
# Signs download links. Any long random string: `openssl rand -hex 32`.
DOWNLOAD_SECRET=

# Ad pixels, loaded on /go/* pages only.
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
